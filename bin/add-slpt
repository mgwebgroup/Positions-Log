#! /usr/bin/gawk -f

# End-of-day SL/PT updater.
#
# Reads consolidated positions from stdin or a CSV file with header, uses:
#   1) meta.csv records keyed as TICKER:<TIMESTAMP> and TICKER:SLPT
#   2) Consolidated positions file produced by `bin/add_unrealized`
#
# It outputs the input rows plus:
#   SL,PT
#
# Meta row formats:
#   TICKER:TIMESTAMP,SL:...,HIGH:...,LOW:...,PT:...,Q:...
#   TICKER:SLPT,SL:...,PT:...,Q:...
#
# Rules:
# - Same-day add/open fills contribute to intraday consolidation.
# - Same-day reducing fills do NOT contribute to intraday SL/PT consolidation.
# - Same-day reducing fills DO adjust remaining quantity in TICKER:SLPT via pos_q.
# - date=YYYY-MM-DD is mandatory.
# - update=1 modifies meta file to consolidate all TICKER:TIMESTAMP rows and
#   then compute SL, PT and Q fields for the TICKER:SLPT record.
#
# Example:
#   ./add-slpt \
#     -v date=2026-07-17 \
#     -v meta_file=Data/meta.csv \
#     -v update=1 \
#     consolidated_positions.csv

@include "data_cache.awk"

BEGIN {
    FS = ","
    OFS = ","

    if (date == "" && ("DATE" in ENVIRON))
        date = ENVIRON["DATE"]
    if (date == "") {
        print "ERROR: date=YYYY-MM-DD is required" > "/dev/stderr"
        exit 2
    }

    if (meta_file == "")
        meta_file = "Data/meta.csv"

    split(date, date_parts, "-")
    year = date_parts[1]

    load_meta(meta_file)
}

function fill_date(ts,    d) {
    d = strftime("%Y-%m-%d", ts)
    return d
}

function kv_value(field, key,    prefix) {
    prefix = key ":"
    if (index(field, prefix) == 1)
        return substr(field, length(prefix) + 1)
    return ""
}

function get_tag(line, key,    f, n, j, v) {
    n = split(line, f, ",")
    for (j = 2; j <= n; j++) {
        v = kv_value(f[j], key)
        if (v != "")
            return v
    }
    return ""
}

function load_meta(file,    line, f, n, idx, ticker, suffix, ts, q, sl, pt, d) {
    while ((getline line < file) > 0) {
        if (line ~ /^[[:space:]]*$/)
            continue

        n = split(line, f, ",")
        idx = f[1]
        split(idx, parts, ":")
        ticker = parts[1]
        suffix = parts[2]

        if (suffix == "SLPT") {
            meta_seen[ticker] = 1
            meta_sl[ticker] = get_tag(line, "SL") + 0
            meta_pt[ticker] = get_tag(line, "PT") + 0
            meta_q[ticker]  = get_tag(line, "Q") + 0
            continue
        }

        ts = suffix + 0
        d = fill_date(ts)
        if (d != date)
            continue

        q  = get_tag(line, "Q") + 0
        sl = get_tag(line, "SL") + 0
        pt = get_tag(line, "PT") + 0

        day_fill_net_q[ticker] += q
        fill_count[ticker]++
        fill_q[ticker, fill_count[ticker]]  = q
        fill_sl[ticker, fill_count[ticker]] = sl
        fill_pt[ticker, fill_count[ticker]] = pt
        fill_ts[ticker, fill_count[ticker]] = ts
    }
    close(file)
}

function compute_day_contribs(ticker, base_q,    i, q, side, adds_q, red_q, w_sl, w_pt) {
    delete contrib

    side = 0
    if (base_q > 0)
        side = 1
    else if (base_q < 0)
        side = -1
    else if (day_fill_net_q[ticker] > 0)
        side = 1
    else if (day_fill_net_q[ticker] < 0)
        side = -1

    if (base_q * day_fill_net_q[ticker] < 0)
        side = 0

    for (i = 1; i <= fill_count[ticker]; i++) {
        q = fill_q[ticker, i]

        if (side == 0) {
            if (q > 0)
                side = 1
            else if (q < 0)
                side = -1
        }

        if (side == 0)
            continue

        if (q * side > 0) {
            adds_q += q
            w_sl += fill_sl[ticker, i] * q
            w_pt += fill_pt[ticker, i] * q
            contrib["count"]++
        } else if (q * side < 0) {
            red_q += q
        }
    }

    contrib["side"]   = side
    contrib["adds_q"] = adds_q + 0
    contrib["red_q"]  = red_q + 0

    if (adds_q != 0) {
        contrib["avg_sl"] = w_sl / adds_q
        contrib["avg_pt"] = w_pt / adds_q
    }
}

function merge_state(ticker, pos_q,    side, old_sl, old_pt, new_sl, new_pt, c_sl, c_pt, carry_prior_state) {
    delete state

    carry_prior_state = (pos_q * meta_q[ticker] > 0)
    if (carry_prior_state) {
        old_sl = meta_sl[ticker]
        old_pt = meta_pt[ticker]
    }

    side = (pos_q > 0) ? 1 : ((pos_q < 0) ? -1 : 0)

    new_sl = old_sl
    new_pt = old_pt

    c_sl = contrib["avg_sl"] + 0
    c_pt = contrib["avg_pt"] + 0

    if ((ticker in meta_seen) && carry_prior_state) {
        if (c_sl > 0)
            new_sl = ((meta_sl[ticker] * meta_q[ticker]) + (c_sl * contrib["adds_q"])) / pos_q
        if (c_pt > 0)
            new_pt = ((meta_pt[ticker] * meta_q[ticker]) + (c_pt * contrib["adds_q"])) / pos_q
    } else {
        if (c_sl > 0) new_sl = c_sl
        if (c_pt > 0) new_pt = c_pt
    }

    state["sl"] = new_sl
    state["pt"] = new_pt
    state["side"] = side
}

function persist_meta(ticker, pos_q,    idx, kv, i) {
    idx = ticker ":SLPT"
    delete kv

    for (i = 1; i <= fill_count[ticker]; i++) {
        data_cache_delete_key(meta_file, ticker ":" fill_ts[ticker, i], "SL")
        data_cache_delete_key(meta_file, ticker ":" fill_ts[ticker, i], "PT")
    }

    if (pos_q == 0) {
        data_cache_delete_record(meta_file, idx)
        return
    }

    kv["SL"] = sprintf("%.2f", state["sl"])
    kv["PT"] = sprintf("%.2f", state["pt"])
    kv["Q"]  = sprintf("%d", pos_q)
    data_cache_set(meta_file, idx, kv)
}

NR == 1 {
    print $0, "SL,PT"
}

NR > 1 {
    ticker = $2
    pos_q = $3 + 0
    record = $0

    delete contrib
    delete state

    compute_day_contribs(ticker, meta_q[ticker] + 0)
    merge_state(ticker, pos_q)

    if (update)
        persist_meta(ticker, pos_q)

    printf "%s,%.2f,%.2f\n",
        record,
        state["sl"] + 0,
        state["pt"] + 0
}

